{
  "expo": {
    "name": "\"Whattodo?\" - Horizon Challenge",
    "slug": "horizon-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.horizon.todo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F5C400"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a97170df-0fa0-4b1b-94f6-8d119e1f6c93"
      }
    },
    "owner": "vrydeveloper"
  }
}
