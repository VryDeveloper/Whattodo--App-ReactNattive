{
  "expo": {
    "name": "Horizon To-Do",
    "slug": "horizon-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.horizon.todo",
      "adaptiveIcon": { "backgroundColor": "#111111" },
      "permissions": ["SCHEDULE_EXACT_ALARM", "POST_NOTIFICATIONS"]
    },
    "web": { "bundler": "metro" },
    "plugins": [["expo-notifications", { "color": "#F5C400" }]]
  }
}
